# Copy this file to .env and fill in your keys. .env is gitignored.

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- optional overrides (defaults shown) ---
# EMBED_MODEL=voyage-3.5
# ANSWER_MODEL=claude-opus-5          # set to claude-sonnet-5 to cut cost on a public widget
# ANSWER_MAX_TOKENS=1024
# TOP_K=4
# CHUNK_TARGET_TOKENS=400
# CHUNK_MAX_TOKENS=500
# CHUNK_OVERLAP_TOKENS=80

# --- Rate limiting on /ask (defaults shown) ---
# RATE_LIMIT_PER_MINUTE=5          # per visitor (IP)
# RATE_LIMIT_PER_DAY=50            # per visitor (IP)
# RATE_LIMIT_GLOBAL_PER_DAY=300    # all visitors together = hard cap on Claude spend

# --- Docker / Caddy ---
# Public domain for automatic HTTPS. Leave unset for local testing (uses "localhost").
# DOMAIN=milan-bot.duckdns.org

# Origins allowed to call the API from a browser (comma-separated).
# Must include your portfolio's origin.
# ALLOWED_ORIGINS=https://milan-kemp.github.io,http://localhost:8000,http://127.0.0.1:8000
